server:
  port: 8080
  mode: debug
  read_timeout: 30s
  write_timeout: 30s
  shutdown_timeout: 30s

database:
  host: localhost
  port: 3306
  user: root
  password: "your_password_here"
  database: oops_reader
  max_open_conns: 100
  max_idle_conns: 10
  conn_max_lifetime: 1h
  conn_max_idle_time: 10m

redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

jwt:
  secret: "change-this-secret-key-in-production-at-least-32-characters"
  access_token_expiry: 1h
  refresh_token_expiry: 168h

log:
  level: info
  format: console
  output_path: stdout

tts:
  default_provider: mimo
  edge:
    base_url: "http://8.136.58.109:80"
    token: ""
  mimo:
    api_key: "tp-c7hxf3c8kjqoffix0bcjq3rxxo0nmn3wdy4s5s1xmx050a0c"
    base_url: "https://token-plan-cn.xiaomimimo.com/v1"
    model: "mimo-v2.5-tts"
  # Ordinary one-shot synthesis is kept conservative. Streaming playback
  # requests consecutive text segments, so it has a separate larger bucket.
  rate_limit:
    enabled: true
    rate: 30
    burst: 5
  stream_rate_limit:
    enabled: true
    rate: 120
    burst: 20
